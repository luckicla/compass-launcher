{
  "name": "compass-launcher",
  "version": "5.3.1",
  "description": "Compass Launcher: juega con tus amigos y monta tus propios servidores de Minecraft con mods",
  "main": "main.js",
  "author": "luckicla",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never",
    "release": "electron-builder --win nsis portable --publish always"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.4",
    "@silentbot1/nat-api": "^0.4.9",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "rcedit": "^3.1.0"
  },
  "build": {
    "appId": "es.compas.launcher",
    "productName": "Compass Launcher",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!build/**",
      "!*.bat",
      "!.github/**",
      "!LEEME.txt",
      "!mobile/**",
      "!docs/**",
      "!mod/**",
      "!*.md"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "legalTrademarks": "Compass Launcher"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Compass Launcher",
      "uninstallDisplayName": "Compass Launcher",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Compass-Launcher-Instalador-${version}.${ext}",
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "include": "build/installer.nsh",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "es_ES",
        "en_US",
        "ca_ES"
      ],
      "language": "3082",
      "displayLanguageSelector": false,
      "warningsAsErrors": false
    },
    "portable": {
      "artifactName": "Compass-Launcher-Portable-${version}.${ext}"
    },
    "copyright": "© 2026 luckicla. Todos los derechos reservados.",
    "afterPack": "build/afterPack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "luckicla",
        "repo": "compass-launcher",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "build/mod",
        "to": "mod",
        "filter": [
          "*.jar"
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/luckicla/compass-launcher.git"
  },
  "license": "UNLICENSED"
}
